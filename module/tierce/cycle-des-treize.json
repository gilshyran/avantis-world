  "festivals": {
    "midwinter0000000": {
      "name": "La fête du Soleil Dieu",
      "description": "C’est la plus grande fête des terres de Khora. Durant cette période, la région Nord de Byblos devient l’épicentre des festivités. Culturellement les habitants de Khora se réunissent en grand nombre dans les plaines près du temple de la griffe. C’est un des rares rassemblement regroupant toutes les classes sociales.",
      "color": "#B0C4DE",
      "icon": "fas fa-snowflake",
      "month": 14,
      "day": 31,
      "duration": 1,
      "leapDuration": null,
      "leapYearOnly": false,
      "countsForWeekday": false
    },
    "springequinox000": {
      "name": "La fête de Coya",
      "description": "La fête de Coya rend grâce aux femmes et surtout aux mères, symboles de fécondité. C’est un des trois grands moments de festivités sur les terres de Khora.",
      "color": "",
      "icon": "",
      "month": 3,
      "day": 13,
      "duration": 2,
      "leapDuration": null,
      "leapYearOnly": false,
      "countsForWeekday": true
    },
    "XMmhfStHtI9WTlG4": {
      "name": "La Fête du sel",
      "description": "La fête du sel a lieu à la fin de la saison sèche, au début du mois d'Homa dans la petite cité de Maras. Cet un événement majeur coïncide avec la fin de la récolte du sel et rassemble marchands venant de tout Khora et aventuriers venant profiter des nombreuses animations proposées par la cité. Il y a notamment la célèbre course de chevaux de Maras ou encore l’épreuve de tir à l’arc rassemblant les meilleurs archers des terres connues.",
      "color": "",
      "icon": "",
      "month": 4,
      "day": 1,
      "duration": 7,
      "leapDuration": null,
      "leapYearOnly": false,
      "countsForWeekday": true
    },
    "csQsQrdVDVHM0jMo": {
      "name": "La fête des esprits",
      "description": "La fête des esprits est une festivité liée aux esprits protecteurs et notamment l’esprit de la terre et du vent qui aide le soleil à faire fuire les oiseaux pour ne pas détruire les récoltes.",
      "color": "#38d435",
      "icon": "fas fa-seedling",
      "month": 4,
      "day": 27,
      "duration": 2,
      "leapDuration": null,
      "leapYearOnly": false,
      "countsForWeekday": true
    },
    "861sNIC3WUXJoCNY": {
