      "color": "",
      "icon": "",
      "month": 5,
      "day": 7,
      "duration": 1,
      "leapDuration": null,
      "leapYearOnly": false,
      "countsForWeekday": true
    },
    "greengrass000000": {
      "name": "Le Qhari",
      "description": "Les enfants sont initiés à devenir des hommes. Le rituel nommé le Qhari, comprend le jeûne, les efforts symboliques et les combats. Les jeunes s'identifient aux animaux qui représentent la valeur : le serpent, le loup et le puma (ou le Feonn selon la région).",
      "color": "#90ee90",
      "icon": "fas fa-seedling",
      "month": 6,
      "day": 26,
      "duration": 3,
      "leapDuration": null,
      "leapYearOnly": false,
      "countsForWeekday": true
    },
    "summersolstice00": {
      "name": "La fête du Solstice",
      "description": "C’est la fête se passant exactement 182 jours après le Zénith, au milieu de l’année. C’est le jour où le soleil est le plus présent mais aussi un jour où la pluie est aussi très présente.\nChaque région fête le soleil et la pluie avec diverses festivités plus ou moins populaires.",
      "color": "",
      "icon": "",
      "month": 7,
